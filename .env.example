# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL Supabase Connection Pooling / Direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stas_rg_oprec?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/stas_rg_oprec?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-stas-rg-jwt-token-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Supabase API & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"

# Recruitment Business Logic
OPREC_IS_ACTIVE=true
CURRENT_OPREC_BATCH="Oprec Batch 1 - 2026"
